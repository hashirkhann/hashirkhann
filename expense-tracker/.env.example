# IMAP settings for the mailbox that receives bank alert emails
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=you@gmail.com
# Use an app password, not your normal login password
EMAIL_PASS=your-app-password
EMAIL_FOLDER=INBOX

# Sender address(es) to treat as bank alerts, comma-separated
BANK_SENDERS=alerts.pk@sc.com

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_WORKSHEET_NAME=Transactions

# Where to persist the last processed email UID between runs
STATE_FILE=state.json
